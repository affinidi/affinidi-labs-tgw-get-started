PORTAL_PORT=8097
# Register <PORTAL_URL>/api/auth/callback/microsoft as the redirect URI
PORTAL_URL=http://localhost:8097
# Scope the portal requests for the user token
# --- Portal (Entra sign-in) -------------------------------------------------
ENTRA_TENANT_ID=
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
USER_TOKEN_AUDIENCE=api://<agent-api-client-id>
USER_TOKEN_SCOPE=agent.access

# --- Agent --------------------------------------------------------------------
AGENT_NAME="Personal Agent"
AGENT_PORT=10004
AGENT_PUBLIC_URL=http://localhost:10004
# Set to send the portal through the gateway agent access point (empty = call the agent directly)
AGENT_GATEWAY_URL=

# --- MCP ------------------------------------------------------------------------
# Direct MCP server: no gateway, the call gets a 401
MCP_URL=https://api.githubcopilot.com/mcp/readonly
# Gateway MCP transit point: injects the user's delegated token (wins over MCP_URL)
# MCP_GATEWAY_URL=https://<your-gateway>/outbound/routes/github/mcp
