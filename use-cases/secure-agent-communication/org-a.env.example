# ── Org A — Thatcher Corp ─────────────────────────────────────────────────────
# Fixed — do not change
NEXT_PUBLIC_ORG_NAME="Organization A"
NEXT_PUBLIC_ORG_ID=org-a
NEXT_PUBLIC_ORG_THEME=blue
NEXT_PUBLIC_URL=http://localhost:3001
PORTAL_PORT=3001
JWT_SECRET=org-a-change-this-in-production

NEXT_PUBLIC_AGENT_NAME="Thatcher Agent"
NEXT_PUBLIC_AGENT_DESCRIPTION="Thatcher Agent is Org A's intelligent assistant for secure cross-org communication."
AGENT_PORT=8001

# ── ★ CHANGE REQUIRED ────────────────────────────────────────────────────────
# Thatcher Agent URL — update at each step:
#   Step 1.1 (local):      http://localhost:8001
#   Step 1.4 (public):     https://<thatcher-public-url>
#   Phase 2 (gateway):     https://<thatcher-gateway>/agents/org-a/thatcher-agent
NEXT_PUBLIC_AGENT_URL=http://localhost:8001

# Same as NEXT_PUBLIC_AGENT_URL until Phase 2, where NEXT_PUBLIC_AGENT_URL becomes
# the gateway URL and AGENT_INTERNAL_URL stays as the direct agent URL for logs
AGENT_INTERNAL_URL=http://localhost:8001

NEXT_PUBLIC_PEER_AGENT_NAME="Dexter Agent"

# Dexter Agent URL — update at each step:
#   Step 1.1 (local):      http://localhost:8011
#   Step 1.4 (public):     https://<dexter-public-url>
#   Phase 2 (gateway):     https://<thatcher-gateway>/outbound/agents/org-a/dexter-agent
PEER_AGENT_URL=http://localhost:8011

# ── ★ FILL IN FROM STEP 1.2 (Entra ID) ──────────────────────────────────────
# Leave empty for Step 1.1 (Guest login works without these)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
ENTRA_APP_ID_URI=
ENTRA_SCOPE_NAME=agent.access
