# ── Org B — Dexter Labs ───────────────────────────────────────────────────────
# Fixed — do not change
NEXT_PUBLIC_ORG_NAME="Organization B"
NEXT_PUBLIC_ORG_ID=org-b
NEXT_PUBLIC_ORG_THEME=green
NEXT_PUBLIC_URL=http://localhost:3002
PORTAL_PORT=3002
JWT_SECRET=org-b-change-this-in-production

NEXT_PUBLIC_AGENT_NAME="Dexter Agent"
NEXT_PUBLIC_AGENT_DESCRIPTION="Dexter Agent is Org B's intelligent assistant for secure cross-org communication."
AGENT_PORT=8011

# ── ★ CHANGE REQUIRED ────────────────────────────────────────────────────────
# Dexter Agent URL — update at each step:
#   Step 1.1 (local):      http://localhost:8011
#   Step 1.4 (public):     https://<dexter-public-url>
#   Phase 2 (gateway):     https://<dexter-gateway>/agents/org-b/dexter-agent
NEXT_PUBLIC_AGENT_URL=http://localhost:8011

# Same as NEXT_PUBLIC_AGENT_URL until Phase 2, where NEXT_PUBLIC_AGENT_URL becomes
# the gateway URL and AGENT_INTERNAL_URL stays as the direct agent URL for logs
AGENT_INTERNAL_URL=http://localhost:8011

NEXT_PUBLIC_PEER_AGENT_NAME="Thatcher Agent"

# Thatcher Agent URL — update at each step:
#   Step 1.1 (local):      http://localhost:8001
#   Step 1.4 (public):     https://<thatcher-public-url>
#   Phase 2 (gateway):     https://<dexter-gateway>/outbound/agents/org-b/thatcher-agent
PEER_AGENT_URL=http://localhost:8001

# ── ★ FILL IN FROM STEP 1.2 (Entra ID) ──────────────────────────────────────
# Leave empty for Step 1.1 (Guest login works without these)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
ENTRA_APP_ID_URI=
ENTRA_SCOPE_NAME=agent.access
