# Shared config for the Echo Agent + DID Auth Portal demo.
# Loaded by run.sh (bash) and portal/server.py (python-dotenv).
# Copy this file to .env and fill in the values for your setup.

AGENT_PORT=8001
PORTAL_PORT=8090

# Direct target used by the portal when no DID Auth session is active
# (i.e. talking straight to the agent, no gateway in front of it yet).
# Use http://localhost:<AGENT_PORT> for local-only testing (Phase A).
# Use a public URL (ngrok, GitHub Codespaces, etc.) once you need the
# gateway to reach the agent (Phases B and C).
AGENT_URL=http://localhost:8001

# Gateway access point URL for the A2A surface (Phases B and C).
# Leave empty until you've created a surface - see readme.md.
GATEWAY_AGENT_URL=
