# ── Optional: AWS Bedrock for the `chat` tool ────────────────────────────────
# The MCP server exposes calculator, weather_forecast, and chat.
# `chat` answers via AWS Bedrock WHEN configured; otherwise it runs in stub mode
# (returns a canned reply). Getting-started works fine without any of this.

# Set a Bedrock model id to enable real chat answers, e.g. a Claude-on-Bedrock
# model id. Leave unset for stub mode.
BEDROCK_MODEL_ID=

AWS_REGION=us-east-1

# AWS credentials are read from the standard chain (env vars, shared profile, or
# an instance/role). Uncomment to set them explicitly:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
