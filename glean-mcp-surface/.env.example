# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI — update this to your ngrok callback URL after running ngrok_tunnel.py
REDIRECT_URI=http://localhost:8081/callback

# MCP Gateway endpoint
GATEWAY_URL=

# Flask app port
PORT=8081

# Flask session secret (change to a strong random value in production)
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ngrok auth token — get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

