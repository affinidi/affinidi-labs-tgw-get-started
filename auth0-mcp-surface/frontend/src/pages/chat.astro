---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chat — Agent Gateway">
  <div class="chat" x-data="chatApp" x-cloak>
    <!-- Top bar -->
    <header class="topbar">
      <div class="brand">
        <span class="brand-logo">⚡</span>
        <div>
          <div class="brand-title">MCP via Agent Gateway</div>
          <div class="brand-sub">Google caller context · Auth0 delegation</div>
        </div>
      </div>
      <div class="user">
        <template x-if="user && user.picture">
          <img :src="user.picture" class="avatar" alt="" referrerpolicy="no-referrer" />
        </template>
        <div class="user-meta">
          <div class="user-name" x-text="user ? user.name : ''"></div>
          <div class="user-email" x-text="user ? user.email : ''"></div>
        </div>
        <button class="btn btn-secondary sm" @click="logout()">Logout</button>
      </div>
    </header>

    <!-- Messages -->
    <main class="messages" x-ref="messages">
      <div class="hint" x-show="messages.length === 0">
        <div class="welcome" x-show="user">
          <template x-if="user && user.picture">
            <img :src="user.picture" class="welcome-avatar" alt="" referrerpolicy="no-referrer" />
          </template>
          <h2 class="welcome-title">Welcome, <span x-text="firstName"></span> 👋</h2>
          <p class="welcome-sub">
            You're signed in with Google. Send your first message — the Agent Gateway
            delegates Auth0 access to the MCP server on your behalf.
          </p>
        </div>
        <div class="quick">
          <button class="chip" @click="listTools()">📋 List Tools</button>
          <button class="chip" @click="send('What can you help me with?')">💬 Say hello</button>
        </div>
      </div>

      <template x-for="m in messages" :key="m.id">
        <div :class="`msg msg-${m.role}`">
          <template x-if="m.role === 'user'">
            <div class="bubble bubble-user" x-text="m.text"></div>
          </template>
          <template x-if="m.role !== 'user'">
            <div class="bubble bubble-agent">
              <template x-if="m.loading">
                <div class="typing"><span></span><span></span><span></span></div>
              </template>
              <template x-if="!m.loading">
                <div x-html="m.html"></div>
              </template>
            </div>
          </template>
        </div>
      </template>
    </main>

    <!-- Composer -->
    <footer class="composer">
      <textarea
        x-ref="input"
        x-model="input"
        @keydown.enter.prevent="onEnter($event)"
        @input="autosize()"
        placeholder="Type a message, or paste raw JSON-RPC…"
        rows="1"
      ></textarea>
      <button class="btn btn-primary send" :disabled="sending || !input.trim()" @click="sendMessage()">
        Send
      </button>
    </footer>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { api, buildChatToolCall } from '../lib/api';
  import { renderResponse, escapeHtml } from '../lib/render';

  let requestId = 1;

  Alpine.data('chatApp', () => ({
    user: null as null | { name: string; email: string; picture: string },
    messages: [] as any[],
    input: '',
    sending: false,

    get firstName() {
      const n = this.user && this.user.name ? this.user.name.trim() : '';
      return n ? n.split(/\s+/)[0] : 'there';
    },

    async init() {
      // Client-side auth guard.
      try {
        const me = await api.me();
        if (!me.authenticated) {
          window.location.href = '/';
          return;
        }
        this.user = me.user as any;
      } catch (_) {
        window.location.href = '/';
      }
    },

    scrollToBottom() {
      this.$nextTick(() => {
        const el = this.$refs.messages as HTMLElement;
        el.scrollTop = el.scrollHeight;
      });
    },

    autosize() {
      const el = this.$refs.input as HTMLTextAreaElement;
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 160) + 'px';
    },

    onEnter(e: KeyboardEvent) {
      if (e.shiftKey) return;
      this.sendMessage();
    },

    pushUser(text: string) {
      this.messages.push({ id: requestId++, role: 'user', text });
    },

    pushLoading() {
      const id = requestId++;
      this.messages.push({ id, role: 'agent', loading: true, html: '' });
      this.scrollToBottom();
      return id;
    },

    resolve(id: number, html: string) {
      const m = this.messages.find((x: any) => x.id === id);
      if (m) {
        m.loading = false;
        m.html = html;
      }
      this.scrollToBottom();
    },

    async sendMessage() {
      const text = this.input.trim();
      if (!text || this.sending) return;
      this.input = '';
      this.$nextTick(() => this.autosize());

      // Raw JSON-RPC passthrough.
      if (text.startsWith('{')) {
        try {
          const parsed = JSON.parse(text);
          await this.callGateway(parsed, text);
          return;
        } catch (_) {
          /* not valid JSON — treat as chat */
        }
      }
      await this.send(text);
    },

    async send(message: string) {
      this.pushUser(message);
      const id = this.pushLoading();
      this.sending = true;
      const requestBody = buildChatToolCall(message, requestId);
      try {
        const data = await api.chat(message);

        // Check for consent_required in response body
        if (data.body?.consent_required?.length > 0) {
          const authUrl = data.body.consent_required[0].authorization_url;
          if (authUrl) {
            this.resolve(id, '<span style="color:#fbbf24">🔐 Opening Auth0 authentication...</span>');
            // Pass the loading message ID so popup handler can update it if popup is blocked
            await this.handleConsentRequired(authUrl, () => this.send(message), id);
            return; // Don't call this.sending = false yet - retry will handle it
          }
        }

        this.resolve(id, renderResponse(data, requestBody));
      } catch (err: any) {
        this.resolve(id, `<span style="color:#fca5a5">Error: ${escapeHtml(err.message)}</span>`);
      } finally {
        this.sending = false;
      }
    },

    async callGateway(body: unknown, label: string) {
      this.pushUser(label);
      const id = this.pushLoading();
      this.sending = true;
      try {
        const data = await api.gateway(body);

        // Check for consent_required in response body
        if (data.body?.consent_required?.length > 0) {
          const authUrl = data.body.consent_required[0].authorization_url;
          if (authUrl) {
            this.resolve(id, '<span style="color:#fbbf24">🔐 Opening Auth0 authentication...</span>');
            // Pass the loading message ID so popup handler can update it if popup is blocked
            await this.handleConsentRequired(authUrl, () => this.callGateway(body, label), id);
            return; // Don't call this.sending = false yet - retry will handle it
          }
        }

        this.resolve(id, renderResponse(data, body));
      } catch (err: any) {
        this.resolve(id, `<span style="color:#fca5a5">Error: ${escapeHtml(err.message)}</span>`);
      } finally {
        this.sending = false;
      }
    },

    listTools() {
      this.callGateway(
        {
          jsonrpc: '2.0',
          id: requestId++,
          method: 'tools/list',
          params: { _meta: { agentIdentity: { name: 'chat-client', version: '1.0.0' } } },
        },
        '📋 List Tools'
      );
    },

    async handleConsentRequired(authUrl: string, originalRequestFn: () => Promise<void>, loadingMessageId: number) {
      console.log('[OnDemandAuth] Opening Auth0 popup...');

      // Open auth URL in centered popup window
      const width = 500;
      const height = 700;
      const left = (window.screen.width - width) / 2;
      const top = (window.screen.height - height) / 2;
      const features = `width=${width},height=${height},left=${left},top=${top},menubar=no,toolbar=no,location=yes,status=no,scrollbars=yes`;

      const popup = window.open(authUrl, 'oauth_popup', features);

      if (!popup) {
        // Popup blocked - show error message with manual fallback
        console.error('[OnDemandAuth] Popup blocked by browser');
        const errorMsg = `
          <div class="auth-card">
            <div class="auth-title">⚠️ Popup Blocked</div>
            <p class="auth-desc">Your browser blocked the authentication popup. Please allow popups for this site, or use the manual link below:</p>
            <a href="${escapeHtml(authUrl)}" target="_blank" rel="noreferrer" class="btn btn-primary auth-btn">Authenticate with Auth0 ↗</a>
            <p style="margin-top:10px;font-size:12px;opacity:0.7;">After authenticating, retry your request.</p>
          </div>
        `;
        this.resolve(loadingMessageId, errorMsg);
        return;
      }

      console.log('[OnDemandAuth] Popup opened, polling for close...');

      // Poll to detect when popup closes
      await this.waitForPopupClose(popup);

      console.log('[OnDemandAuth] Popup closed, auto-retrying request...');

      // Small delay to ensure OAuth callback completed
      await new Promise(resolve => setTimeout(resolve, 500));

      // Automatically retry the original request
      await originalRequestFn();
    },

    async waitForPopupClose(popup: Window) {
      return new Promise<void>((resolve) => {
        const pollInterval = setInterval(() => {
          try {
            if (popup.closed) {
              clearInterval(pollInterval);
              resolve();
            }
          } catch (e) {
            // Cross-origin error - keep polling
          }
        }, 500);

        // Timeout after 5 minutes
        setTimeout(() => {
          clearInterval(pollInterval);
          resolve();
        }, 5 * 60 * 1000);
      });
    },

    async logout() {
      try {
        await api.logout();
      } finally {
        window.location.href = '/';
      }
    },
  }));

  Alpine.start();
</script>

<style is:global>
  /* Response cards / caller-context styles (global so x-html content is styled) */
  .response-card {
    background: #0f172a;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .response-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: var(--text-disabled);
    margin-bottom: 8px;
  }
  .response-text { font-size: 14px; line-height: 1.65; }
  .response-text p { margin-bottom: 10px; }
  .response-text p:last-child { margin-bottom: 0; }
  .response-text code {
    font-family: var(--font-family-mono);
    background: #1e293b;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
  }
  .response-text a { color: var(--app-accent-cyan); }
  .response-divider { border: none; border-top: 1px solid var(--border-default); margin: 10px 0; }

  .tools-list { display: flex; flex-direction: column; gap: 8px; }
  .tool-card { background: #131c2b; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 10px 12px; }
  .tool-name { font-weight: 600; font-size: 13px; margin-bottom: 3px; }
  .tool-description { font-size: 12px; color: var(--text-secondary); }

  .meta-list { padding: 10px 12px; }
  .meta-row { display: flex; gap: 10px; font-size: 12px; padding: 2px 0; }
  .meta-key { color: var(--text-disabled); min-width: 120px; }
  .meta-value { color: var(--text-secondary); word-break: break-word; }

  /* Auth0 consent card */
  .auth-card {
    background: #2d1a00;
    border: 1px solid var(--app-accent-yellow);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .auth-title { font-weight: 700; font-size: 14px; color: #fde68a; margin-bottom: 8px; }
  .auth-url {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--app-accent-cyan);
    background: #0b0f16;
    border-radius: 6px;
    padding: 8px 10px;
    word-break: break-all;
    margin-bottom: 8px;
  }
  .auth-desc { font-size: 11px; color: #94a3b8; margin-bottom: 10px; }
  .auth-btn { text-decoration: none; }

  /* Access-denied card */
  .denied-card {
    background: #2a0f0f;
    border: 1px solid #f87171;
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .denied-title { font-weight: 700; font-size: 14px; color: #fca5a5; margin-bottom: 8px; }
  .denied-desc { font-size: 12px; color: #fecaca; line-height: 1.5; margin-bottom: 10px; }
  .denied-reason {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: #fda4af;
    background: #1a0808;
    border-radius: 6px;
    padding: 8px 10px;
    word-break: break-word;
  }

  /* Caller-context card */
  .ctx-card { background: #0f172a; border: 1px solid var(--button-primary-bg); border-radius: var(--radius-sm); margin-bottom: 10px; overflow: hidden; }
  .ctx-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    background: #1e1b4b;
    color: #c7d2fe;
  }
  .ctx-badge {
    margin-left: auto;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    background: #312e81;
    color: #a5b4fc;
    padding: 3px 8px;
    border-radius: 999px;
  }
  .ctx-body { padding: 14px; display: flex; flex-direction: column; gap: 14px; }
  .ctx-section-title { font-size: 11px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }
  .ctx-hint { font-size: 9px; font-weight: 500; }
  .ctx-hint.indigo { color: var(--text-secondary); }
  .ctx-hint.yellow { color: var(--app-accent-yellow); }
  .ctx-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ctx-field { background: #0b0f16; border: 1px solid var(--border-subtle); border-radius: 6px; padding: 8px 10px; }
  .ctx-field.full { grid-column: 1 / -1; }
  .ctx-field .lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-disabled); margin-bottom: 3px; }
  .ctx-field .val { font-size: 12px; font-family: var(--font-family-mono); color: var(--text-secondary); word-break: break-all; }
  .ctx-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ctx-chip { font-size: 11px; background: #052e2b; border: 1px solid var(--app-accent-green); border-radius: 999px; padding: 4px 10px; color: #6ee7b7; }
  .ctx-chip.yellow { background: #2d1a00; border-color: var(--app-accent-yellow); color: #fde68a; }
</style>

<style>
  .chat { display: flex; flex-direction: column; height: 100vh; }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-default);
    background: var(--surface-raised);
    flex-shrink: 0;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .brand-title { font-size: 14px; font-weight: 700; }
  .brand-sub { font-size: 11px; color: var(--text-disabled); }

  .user { display: flex; align-items: center; gap: 12px; }
  .avatar {
    width: 34px; height: 34px; border-radius: 50%;
    border: 2px solid var(--button-primary-bg);
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.18);
  }
  .user-meta { text-align: right; }
  .user-name { font-size: 13px; font-weight: 600; }
  .user-email { font-size: 11px; color: var(--text-disabled); }
  .btn.sm { padding: 7px 12px; font-size: 12px; }

  .messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .hint { color: var(--text-secondary); font-size: 13px; text-align: center; margin: auto; }
  .welcome { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 18px; }
  .welcome-avatar {
    width: 64px; height: 64px; border-radius: 50%;
    border: 2px solid var(--button-primary-bg);
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
  }
  .welcome-title { font-size: 20px; font-weight: 700; color: var(--text-primary); }
  .welcome-sub { font-size: 13px; color: var(--text-secondary); line-height: 1.6; max-width: 440px; margin: 0 auto; }
  .quick { display: flex; gap: 8px; justify-content: center; margin-top: 12px; flex-wrap: wrap; }
  .chip {
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 12px;
    cursor: pointer;
  }
  .chip:hover { border-color: var(--button-primary-bg); }

  .msg { display: flex; }
  .msg-user { justify-content: flex-end; }
  .bubble { max-width: 78%; padding: 12px 16px; border-radius: var(--radius-md); line-height: 1.5; font-size: 14px; }
  .bubble-user { background: var(--button-primary-bg); color: #fff; border-bottom-right-radius: 4px; }
  .bubble-agent { background: var(--surface-raised); border: 1px solid var(--border-default); border-bottom-left-radius: 4px; max-width: 88%; }

  .typing { display: flex; gap: 4px; padding: 4px 0; }
  .typing span { width: 8px; height: 8px; border-radius: 50%; background: var(--text-disabled); animation: bounce 1.4s infinite ease-in-out both; }
  .typing span:nth-child(1) { animation-delay: -0.32s; }
  .typing span:nth-child(2) { animation-delay: -0.16s; }
  @keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

  .composer {
    display: flex;
    gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid var(--border-default);
    background: var(--surface-raised);
    flex-shrink: 0;
  }
  .composer textarea {
    flex: 1;
    resize: none;
    background: #0b0f16;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: var(--font-family-sans);
    font-size: 14px;
    padding: 12px 14px;
    line-height: 1.4;
    max-height: 160px;
  }
  .composer textarea:focus { outline: none; border-color: var(--button-primary-bg); }
  .send { align-self: flex-end; }
</style>
