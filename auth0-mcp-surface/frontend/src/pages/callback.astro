---
import Layout from '../layouts/Layout.astro';
---

<!--
  The FastAPI backend owns the real OAuth callback (/api/auth/callback): it
  exchanges the code, sets the session cookie, and redirects here → /chat.
  This page only exists as a safety net if the browser lands on /callback
  directly: it checks the session and routes accordingly.
-->
<Layout title="Signing in…">
  <main class="cb" x-data="callbackPage" x-cloak>
    <div class="spinner"></div>
    <p x-text="message">Completing sign-in…</p>
  </main>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { api } from '../lib/api';

  Alpine.data('callbackPage', () => ({
    message: 'Completing sign-in…',
    async init() {
      try {
        const me = await api.me();
        window.location.href = me.authenticated ? '/chat' : '/';
      } catch (_) {
        this.message = 'Could not reach the backend. Redirecting…';
        window.location.href = '/';
      }
    },
  }));
  Alpine.start();
</script>

<style>
  .cb {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    color: var(--muted);
    font-size: 14px;
  }
  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
