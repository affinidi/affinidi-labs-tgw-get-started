---
// Design-system tokens (vendored locally: tokens + fonts + reset + utilities +
// themes). Imported FIRST so our app-specific extensions in global.css layer on top.
import '../styles/design-system/globals.css';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!--
  data-theme="dark"          → pin the dark brand palette (ignore OS light preference)
  data-product-theme="fabric" → Affinidi Fabric brand accents (Trust Infrastructure)
-->
<!doctype html>
<html lang="en" data-theme="dark" data-product-theme="fabric">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MCP via Affinidi Trust Gateway — Google caller context, Auth0 credential delegation" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
