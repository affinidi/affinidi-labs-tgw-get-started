# ── Google OAuth (caller context) ─────────────────────────────────────────────
# The user authenticates with Google; the Trust Gateway verifies this JWT and
# uses it as the caller context. This is UNCHANGED from the original demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback (must match the redirect URI registered in Google Cloud Console).
# LEAVE THIS UNSET normally — it is derived automatically:
#   BACKEND_URL set → <BACKEND_URL>/api/auth/callback
#   otherwise       → http://localhost:8642/api/auth/callback
# Only set it to override the derivation.
# REDIRECT_URI=

# ── Trust Gateway ──────────────────────────────────────────────────────────────
# The gateway **Channel Route** URL you get after registering an MCP surface in
# the gateway (Add Surface → MCP Surface Starter → Managed Agent → Direct URL =
# your MCP server's public/proxy URL). This is NOT the MCP server URL itself and
# NOT this chat backend — it's the gateway route that sits in front of the MCP
# server. The gateway verifies the Google JWT (caller context) and can delegate
# an upstream credential on demand; those upstream secrets live in the gateway's
# own secret store — NOT here.
GATEWAY_URL=

# Auth0 credential delegation callback URL (configured in Trust Gateway)
# This is where the Trust Gateway redirects after Auth0 authentication for
# credential delegation. Format: https://<gateway-host>/v1/identity/oauth/callback/<provider-name>
# Example: https://sa-primary.trustgateway.affinidi.io/v1/identity/oauth/callback/chat-auth0-provider
# This URL must be registered in your Auth0 application's "Allowed Callback URLs"
# AND configured in the Trust Gateway's credential delegation provider settings.
# NOTE: This is documentation only - the backend code doesn't use this variable.
# The Trust Gateway handles the OAuth callback.
AUTH0_CALLBACK_URL=https://sa-primary.trustgateway.affinidi.io/v1/identity/oauth/callback/chat-auth0-provider

# ── Public exposure (ngrok / Codespaces / proxy) ────────────────────────────
# This backend's public base URL. Drives the OAuth callback and is added to
# CORS. For single-origin (backend also serves the UI) this is the only URL you
# need. For a split deploy, also set FRONTEND_URL below.
#   e.g. BACKEND_URL=https://<name>-8642.app.github.dev  (Codespaces)
#        BACKEND_URL=https://<subdomain>.ngrok-free.app  (ngrok)
BACKEND_URL=

# ── Frontend origin ───────────────────────────────────────────────────────────
# Where the browser lands after login. Only needed when the frontend is served
# from a DIFFERENT host than this backend:
#   - two-server dev (make dev):   http://localhost:5137
#   - split deploy:                https://<frontend-host>
# In single-origin (make local-up / Docker) leave it unset — it defaults to this
# server's own origin.
FRONTEND_URL=http://localhost:5137

# ── Session cookie domain (split / shared-subdomain deploy) ──────────────────
# When frontend and backend are different SUBDOMAINS of the same site (e.g.
# app.example.com + api.example.com), set this to the shared parent so both
# hosts share the session cookie (SameSite=Lax still works — same-site). Scope
# it as narrowly as possible, NOT the bare registrable domain. Leave unset for
# single-origin; it is auto-derived when frontend/backend share a parent.
#   e.g. SESSION_COOKIE_DOMAIN=proxy.apse1.octo.affinidi.io
SESSION_COOKIE_DOMAIN=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8642

# Session cookie signing secret — set a stable value so sessions survive
# restarts (defaults to a fresh random value each boot otherwise).
SESSION_SECRET=change-me-to-a-random-secret
