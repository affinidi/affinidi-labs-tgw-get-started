# ── Chat MCP server config ───────────────────────────────────────────────────
# The `chat` tool answers via AWS Bedrock WHEN configured; otherwise it runs in
# stub mode (returns a canned reply). Getting-started works without any of this.

# Set a Bedrock model id to enable real chat answers (e.g. a Claude-on-Bedrock
# model id). Leave unset for stub mode.
BEDROCK_MODEL_ID=

AWS_REGION=us-east-1

# AWS credentials come from the standard chain (env, shared profile, or role).
# Uncomment to set explicitly:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Server port (the gateway MCP surface's Direct URL points at this, via a proxy).
PORT=9740
