# --- Entra tenant --------------------------------------------------------------
ENTRA_TENANT_ID=

# --- App 1: Portal (the user's sign-in client) ---------------------------------
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=

# --- App 2: Orchestrator Agent (receives the user token, performs OBO) ---------
ORCH_CLIENT_ID=
ORCH_CLIENT_SECRET=

# --- Token 1: USER token (Portal -> Orchestrator) ------------------------------
# Used by the Portal (to request it at sign-in) and the Orchestrator (to validate it).
USER_TOKEN_AUDIENCE=api://<orchestrator-client-id>
USER_TOKEN_SCOPE=agent.access

# --- Token 2: OBO token (Orchestrator -> Advisory) ------------------------------
# Used by the Orchestrator (to request it from Entra) and the Advisory agent (to validate it).
OBO_TOKEN_AUDIENCE=api://<advisory-client-id>
OBO_TOKEN_SCOPE=advisory.read

# --- Local ports ---------------------------------------------------------------
PORTAL_PORT=8095
ORCH_PORT=10003
ADVISORY_PORT=10002
PORTAL_PUBLIC_URL=http://localhost:8095
PORTAL_ORIGINS=http://localhost:8095

# --- Agent URLs -----------------------------------------------------------------
# *_PUBLIC_URL : each agent's own address, also advertised in its agent card.
#   Phase 1: localhost. Phase 2: the public tunnel URL so the gateway can reach it.
#   The Portal calls ORCH_PUBLIC_URL when no gateway URL is set; the Orchestrator calls
#   ADVISORY_PUBLIC_URL when no gateway URL is set.
# *_GATEWAY_URL : gateway surface URLs (Phase 2 only; leave empty for Phase 1).
#   ORCH_GATEWAY_URL     : Portal -> Surface A (orchestrator); wins over the public URL
#   ADVISORY_GATEWAY_URL : Orchestrator -> Surface B (advisory); wins over the public URL
ORCH_PUBLIC_URL=http://localhost:10003
ADVISORY_PUBLIC_URL=http://localhost:10002
ORCH_GATEWAY_URL=
ADVISORY_GATEWAY_URL=

# Print raw JWTs in the agent logs and trace. Local lab only.
LOG_RAW_TOKEN=false
