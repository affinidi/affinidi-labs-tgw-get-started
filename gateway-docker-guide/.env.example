# Settings for compose.yaml. Copy this file to .env and change what you need:
#   cp .env.example .env
# Every line is optional. The values below are the defaults.

# Address that browsers and agents use to reach the gateway.
# On a server, set your DNS name, for example https://gateway.example.com
# Takes effect on the first start only.
PUBLIC_URL=http://localhost:8080

# Where the ports open. 127.0.0.1 = this computer only. 0.0.0.0 = all networks.
# Must be an IP address, not a name.
AG_PUBLISH_ADDRESS=127.0.0.1

# Ports on this computer. Change them if 8080 or 8443 is in use.
# Set them before the first start.
AG_HTTP_PORT=8080
AG_HTTPS_PORT=8443

# Log level: error, warn, info, or debug
RUST_LOG=info

# Run a different gateway image or version. Leave it commented to use the image in compose.yaml.
# AG_IMAGE=public.ecr.aws/affinidi/agent-gateway:v1.0.10
